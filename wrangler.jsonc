{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "survey-oze-au",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "survey.oze.net.au",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "survey-responses",
      "database_id": "4d299038-e4a0-44fb-9b0b-d5fd1ec4b4a2",
      "migrations_dir": "./migrations"
    }
  ]
}
