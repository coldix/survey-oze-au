---
import BaseLayout from '../layouts/BaseLayout.astro';
import Faq from '../components/Faq.astro';
import { listSurveys } from '../lib/surveys';
import { HOME, HOME_FAQ, POLL_URL, SITE, breadcrumbJsonLd, faqJsonLd, websiteJsonLd } from '../lib/site';

const surveys = listSurveys();
const jsonLd = [
  websiteJsonLd(),
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: HOME.title,
    url: SITE.url,
    inLanguage: 'en-AU',
    description: HOME.description,
    isPartOf: { '@type': 'WebSite', name: SITE.name, url: SITE.url },
    mainEntity: {
      '@type': 'ItemList',
      name: 'Current surveys',
      numberOfItems: 1 + surveys.length,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Monthly voting poll', url: POLL_URL },
        ...surveys.map((survey, index) => ({
          '@type': 'ListItem',
          position: index + 2,
          name: survey.title,
          url: `${SITE.url}/s/${survey.slug}`,
        })),
      ],
    },
  },
  breadcrumbJsonLd([{ name: 'Home', url: SITE.url }]),
  faqJsonLd(HOME_FAQ),
];
---
<BaseLayout title={HOME.title} description={HOME.description} jsonLd={jsonLd}>
  <div class="wrap" style="padding-block: 2.4rem;">
    <section class="hero">
      <p class="phase-tag">oze.au surveys</p>
      <h1>Ask better questions.</h1>
      <p class="lede">Anonymous educational surveys from the oze.au family. Each one is a data file; the runner is shared. Results are stored for real, not simulated.</p>
    </section>
    <div class="survey-list">
      <a class="survey-card" href="/s/monthly-poll">
        <h2>Monthly voting poll</h2>
        <p class="lede">How would you vote at the Victorian election on 28 November 2026, and at the next federal election? One combined survey each month until election day. Not a scientific poll — sourced averages live at electiontracker.au.</p>
      </a>
      {surveys.map((survey) => (
        <a class="survey-card" href={`/s/${survey.slug}`}>
          <h2>{survey.title}</h2>
          <p class="lede">{survey.subtitle} · about {survey.minutes} minutes</p>
        </a>
      ))}
    </div>
    <Faq items={HOME_FAQ} />
  </div>
</BaseLayout>
